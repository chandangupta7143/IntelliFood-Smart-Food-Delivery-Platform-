# ============================================================
# IntelliFood Backend — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the filled-in .env to version control.
# This file (with placeholder values only) IS safe to commit.
# ============================================================

# ── Server ──────────────────────────────────────────────────
SERVER_PORT=8082

# ── MongoDB ─────────────────────────────────────────────────
# Local development default:
MONGODB_URI=mongodb://localhost:27017/food_delivery
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/food_delivery?retryWrites=true&w=majority

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank for no-auth local Redis; set for production:
REDIS_PASSWORD=

# ── JWT Authentication ───────────────────────────────────────
# Minimum 256-bit (32-byte) secret for HS512.
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── Surge Pricing HMAC Token ────────────────────────────────
# Minimum 256-bit secret.
# Generate with: openssl rand -hex 32
SURGE_TOKEN_SECRET=

# ── Admin Bootstrap Account ─────────────────────────────────
# These credentials create the ADMIN user on first startup.
ADMIN_EMAIL=admin@intellifood.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# ── Restaurant Owner Bootstrap Account ───────────────────────
# These credentials create the default RESTAURANT_OWNER user on first startup.
# In production, change the password to a strong secret.
RESTAURANT_OWNER_EMAIL=owner@fooddelivery.com
RESTAURANT_OWNER_PASSWORD=
RESTAURANT_OWNER_NAME=Chef Ramesh (Owner)

# ── CORS Allowed Origins ────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development default (if unset): http://localhost:5173,http://localhost:4173
# Production example:
# CORS_ALLOWED_ORIGINS=https://app.intellifood.com,https://admin.intellifood.com
CORS_ALLOWED_ORIGINS=

